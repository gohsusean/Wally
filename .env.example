# Wally environment variables
#
# Copy to .env and fill in values. Wally loads this file automatically on startup.
# Never commit .env.
#
# WALLY_CONFIG=macbook          # Config profile: macbook | macmini
# WALLY_REASONING_PROFILE=balanced  # fast | balanced | deep (requires providers.llm.profiles)
# WALLY_DRY_RUN=false           # Log actions without executing
# WALLY_LOG_LEVEL=INFO          # DEBUG | INFO | WARNING | ERROR
#
# --- Secrets ---
# OPENAI_API_KEY=
# NOTION_API_KEY=
# HOME_ASSISTANT_URL=
# HOME_ASSISTANT_TOKEN=
# N8N_WEBHOOK_BASE_URL=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=   # run scripts/google_auth.py once
#
# 1Password CLI (v0.11): no token in .env when using `op signin`.
# Optional service account: OP_SERVICE_ACCOUNT_TOKEN=
